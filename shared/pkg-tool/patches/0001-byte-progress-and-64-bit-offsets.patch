+// bb-pkg-tool: byte progress for the app ("Progress-bytes: <done> <total>", every 32 MiB and at the
+// end), the file bytes still to extract (PKG::GetTotalFileBytes) and 64-bit offsets/sizes.
+static u64 g_bytes_total = 0;
+static u64 g_bytes_done = 0;
+static u64 g_bytes_reported = 0;
+static constexpr u64 ProgressStep = 32ull << 20;
+
+void PkgReportBytes(bool force) {
+    if (force || g_bytes_done - g_bytes_reported >= ProgressStep) {
+        g_bytes_reported = g_bytes_done;
+        std::printf("Progress-bytes: %llu %llu\n", static_cast<unsigned long long>(g_bytes_done),
+                    static_cast<unsigned long long>(g_bytes_total));
+        std::fflush(stdout);
+    }
+}
+
+u64 PKG::GetTotalFileBytes(const std::vector<int>& indices) {
+    u64 total = 0;
+    for (int idx : indices) {
+        if (fsTable[idx].type == PFS_FILE) {
+            total += static_cast<u64>(iNodeBuf[fsTable[idx].inode].Size);
+        }
+    }
+    g_bytes_total = total;
+    g_bytes_done = 0;
+    g_bytes_reported = 0;
+    return total;
+}
